{
  "name": "docuclean-ledger-mcp",
  "version": "1.0.0",
  "description": "Commercial Pay-Per-Event Apify Actor & Model Context Protocol (MCP) Server for deterministic statement/invoice reconciliation, PDF-to-XLSX table extraction, and CJK CSV mojibake repair.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "docuclean-ledger-mcp": "./bin/docuclean-ledger-mcp.mjs"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./main": "./src/main.mjs",
    "./tools": "./src/mcp/tools.mjs",
    "./server": "./src/mcp/server.mjs"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "start:stdio": "node ./src/index.js --stdio",
    "start:http": "node ./src/index.js --http",
    "dev": "node ./src/index.js --http",
    "test": "node --test ./tests/actor_and_mcp.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "apify",
    "apify-actor",
    "pay-per-event",
    "mcpize",
    "x402",
    "reconciliation",
    "invoice",
    "alipay",
    "wechat-pay",
    "pdf-to-excel",
    "xlsx",
    "mojibake",
    "gb18030",
    "cjk",
    "csv"
  ]
}
