{
  "actorOutputSchemaVersion": 1,
  "title": "DocuClean & LedgerClean MCP Output",
  "description": "Structured reconciliation / table extraction output plus downloadable .xlsx and UTF-8 BOM .csv artifacts.",
  "type": "object",
  "properties": {
    "datasetResults": {
      "type": "string",
      "title": "Structured Results Dataset",
      "template": "{{links.apiDefaultDatasetUrl}}/items"
    },
    "xlsxWorkbook": {
      "type": "string",
      "title": "Generated Excel Workbook (.xlsx)",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/OUTPUT.xlsx"
    },
    "cleanUtf8Csv": {
      "type": "string",
      "title": "Formula-Safe UTF-8 BOM CSV (.csv)",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/OUTPUT.csv"
    }
  }
}
